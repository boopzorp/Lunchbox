rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 🔐 Secure User Vault Rule:
    // Ensures that logged-in users can ONLY read and write their own personal vault document.
    // Prevents unauthorized access or modification of other users' journals.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Deny all other read/write requests by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
